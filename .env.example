# METAVR WebXR Platform - Environment Configuration Schema

# Database Connection (MongoDB Atlas or PostgreSQL / SQLite)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/metavr?retryWrites=true&w=majority"

# Authentication
JWT_SECRET="production_jwt_secret_key_change_me_12345"

# Server Ports
PORT=5000
NODE_ENV="production"

# Frontend API Endpoint
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Cloudflare R2 / AWS S3 Storage (Optional)
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="vr-platform-assets"
CDN_URL="http://localhost:5000/uploads"
